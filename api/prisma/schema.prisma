// Upgrade Pessoal — modelo de dados (SQLite via Prisma)
// App single-player: um usuário por instalação. Backup = copiar a pasta ../data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Personagem (singleton, id = 1). Nasce vazio; quem calibra é o /briefing.
model Character {
  id        Int      @id @default(1)
  name      String   @default("Jogador")
  xp        Int      @default(0)
  stats     String   @default("{}") // JSON: {"Renda":30,"Domínio Técnico":70,...}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Escada de títulos personalizada, gerada pelo /briefing (level = nível mínimo).
model Title {
  id        Int      @id @default(autoincrement())
  level     Int
  name      String
  updatedAt DateTime @updatedAt @default(now())
}

// Briefing completo em markdown, escrito na conversa com o cowork. Versionado:
// cada revisão é uma linha nova; a mais recente é a ativa.
model Briefing {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

// Check-in diário (para o streak)
model Visit {
  id        Int      @id @default(autoincrement())
  date      String   @unique // ISO yyyy-mm-dd
  updatedAt DateTime @updatedAt @default(now())
}

// Arco semanal (definido todo domingo). Acontece em um "andar" (estilo SAO).
model Week {
  id        Int       @id @default(autoincrement())
  floor     Int // andar da torre
  theme     String // "Existir no Digital"
  startDate String // ISO yyyy-mm-dd (domingo)
  status    String    @default("active") // active | closed
  rating    Int? // 1-5 estrelas do arco (definido no fechamento)
  review    String? // texto da revisão de domingo
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt @default(now())
  missions  Mission[]
}

// Missão (quest) dentro de um arco
model Mission {
  id          Int          @id @default(autoincrement())
  weekId      Int
  week        Week         @relation(fields: [weekId], references: [id], onDelete: Cascade)
  order       Int          @default(0)
  // main = missão linear do arco (a próxima destrava quando a anterior fecha)
  // side = quest opcional de XP bônus. Quem decide é o cowork ao montar o arco.
  kind        String       @default("main")
  title       String
  description String? // "mínimo do dia"
  bonus       String? // "bônus se tiver pique"
  xp          Int          @default(0)
  statGains   String       @default("{}") // JSON: {"Presença Digital":18}
  status      String       @default("pending") // pending | done
  rating      Int? // estrelas da entrega (fechamento)
  completedAt DateTime?
  updatedAt   DateTime     @updatedAt @default(now())
  attachments Attachment[]
}

// Prova anexada a uma missão
model Attachment {
  id           Int      @id @default(autoincrement())
  missionId    Int
  mission      Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  filename     String // nome no disco (uploads/)
  originalName String
  mimeType     String
  size         Int
  clientUuid   String?  @unique // idempotência: prova enviada pelo celular só entra uma vez
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())
}

// Chefão = valor devido. HP = valor restante. "Ataque" = pagamento.
// kind "debt"  → dívida pura: derrotada vira história.
// kind "item"  → aquisição:  quitada vira item na bolsa de itens.
model Debt {
  id        Int       @id @default(autoincrement())
  name      String
  note      String?
  kind      String    @default("debt") // debt | item
  total     Float // valor total (HP máximo)
  status    String    @default("active") // active | dead
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt @default(now())
  payments  Payment[]
}

model Payment {
  id         Int      @id @default(autoincrement())
  debtId     Int
  debt       Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount     Float
  note       String?
  date       DateTime @default(now())
  clientUuid String?  @unique // idempotência: ataque lançado pelo celular só entra uma vez
  updatedAt  DateTime @updatedAt @default(now())
}

// Configs livres (meta de renda, reserva, etc.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @default(now())
}

// ─────────────────────────── sincronização com o app mobile ───────────────────────────
// O pull usa `updatedAt` de cada modelo como cursor. Deleção não deixa updatedAt,
// então vira lápide aqui. Cascatas NÃO geram lápide: o banco do app repete as mesmas
// FKs ON DELETE CASCADE e apaga os filhos sozinho.
model Tombstone {
  id       Int      @id @default(autoincrement())
  entity   String // mission | attachment | debt | payment | title | week
  entityId String // id como texto (Setting usaria a key)
  at       DateTime @default(now())

  @@index([at])
}

// Idempotência do push: cada operação vinda do celular aplica no máximo uma vez.
// É isso que impede a mesma missão de creditar XP duas vezes quando o envio repete.
model SyncOp {
  opId       String   @id // uuid gerado no aparelho
  deviceId   String
  type       String
  status     String // applied | conflict | rejected
  resultJson String?
  createdAt  DateTime @default(now())

  @@index([deviceId])
}

// Aparelho pareado por QR.
model Device {
  id           String    @id // uuid do aparelho
  name         String
  lastPulledAt DateTime? // cursor entregue no último pull
  lastSeen     DateTime  @updatedAt
  createdAt    DateTime  @default(now())
}
