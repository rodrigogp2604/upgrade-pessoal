# deps
node_modules/
**/node_modules/

# builds
dist/
**/dist/
api/public/

# A pasta data/ é do usuário: banco, provas e o APK publicado. Nada disso vai pro git —
# ignorar a pasta inteira evita commitar um binário de 60 MB por distração.
data/*
!data/.gitkeep

# ambiente
.env
**/.env
*.local
.claude/settings.local.json

# backups locais (inclui o histórico git da era pessoal)
backups/

# logs / sistema
*.log
.DS_Store
Thumbs.db
